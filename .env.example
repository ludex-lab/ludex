# Ludex environment — copy to `.env` and fill in.
# `.env` is git-ignored; this template (.env.example) is safe to commit.
# Only needed for BYO-key brain providers (anthropic / openai / gemini_api).
# CLI-auth (claude_cli, codex_cli, ...) and local (ollama) need NO key here.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
